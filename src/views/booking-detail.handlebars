<h1>Reserva #{{booking.id}}</h1>

<p>Cliente: {{booking.clientName}}</p>
<p>Email: {{booking.clientEmail}}</p>
<p>Fecha: {{booking.date}}</p>
<p>Hora: {{booking.time}}</p>
<p>Estado: {{booking.status}}</p>

<h2>Servicios asociados</h2>

{{#each booking.services}}
  <article>
    <h3>{{service.name}}</h3>
    <p>Descripción: {{service.description}}</p>
    <p>Duración: {{service.duration}} minutos</p>
    <p>Precio: ${{service.price}}</p>
    <p>Categoría: {{service.category}}</p>
    <p>Cantidad reservada: {{quantity}}</p>
  </article>
{{else}}
  <p>Esta reserva todavía no tiene servicios asociados.</p>
{{/each}}